/* ===== Global ===== */
* {
  font-family: "Microsoft YaHei UI";
  font-size: 12px;
}

QMainWindow {
  background: #f6f7fb;
}

QLabel#Title {
  font-size: 16px;
  font-weight: 700;
  color: #1f2328;
}

QLabel#SubTitle {
  color: #57606a;
}

/* ===== Cards ===== */
QFrame[card="true"] {
  background: #ffffff;
  border: 1px solid #e6e8ef;
  border-radius: 10px;
}

QFrame[cardHeader="true"] {
  background: transparent;
  border: none;
}

/* ===== Buttons ===== */
QPushButton {
  background: #ffffff;
  border: 1px solid #d0d7de;
  border-radius: 8px;
  padding: 7px 12px;
  color: #1f2328;
}

QPushButton:hover {
  border-color: #8c959f;
  background: #f3f4f6;
}

QPushButton:pressed {
  background: #eaeef2;
}

QPushButton[primary="true"] {
  background: #2563eb;
  border: 1px solid #2563eb;
  color: #ffffff;
}

QPushButton[primary="true"]:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;
}

QPushButton[danger="true"] {
  background: #ef4444;
  border: 1px solid #ef4444;
  color: #ffffff;
}

QPushButton:disabled {
  background: #f6f7fb;
  border-color: #e6e8ef;
  color: #8c959f;
}

/* ===== Inputs ===== */
QLineEdit {
  background: #ffffff;
  border: 1px solid #d0d7de;
  border-radius: 8px;
  padding: 6px 10px;
}

QLineEdit:focus {
  border-color: #2563eb;
}

/* ===== List ===== */
QListWidget {
  background: #ffffff;
  border: 1px solid #e6e8ef;
  border-radius: 10px;
  padding: 6px;
}

QListWidget::item {
  padding: 10px;
  border-radius: 8px;
}

QListWidget::item:hover {
  background: #f3f4f6;
}

/* ===== TextEdit / Log ===== */
QTextEdit {
  background: #0b1020;
  color: #d1d5db;
  border: 1px solid #1f2937;
  border-radius: 10px;
  padding: 8px;
  font-family: Consolas;
  font-size: 11px;
}

/* ===== Scrollbar (optional) ===== */
QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 0px;
}

QScrollBar::handle:vertical {
  background: #c7cbd6;
  border-radius: 5px;
  min-height: 40px;
}

QScrollBar::handle:vertical:hover {
  background: #aeb4c2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}


/* ===== Checkbox (make it bigger + green) ===== */
QCheckBox {
  spacing: 10px;
}

QCheckBox::indicator {
  width: 18px;
  height: 18px;
  border-radius: 5px;
  border: 1px solid #c7cbd6;
  background: #ffffff;
}

QCheckBox::indicator:hover {
  border-color: #6b7280;
}

QCheckBox::indicator:checked {
  background: #22c55e;          /* green */
  border: 1px solid #16a34a;
}

QCheckBox::indicator:checked:hover {
  background: #16a34a;
}

/* ===== Make QListWidget item checkbox use same indicator ===== */
QListWidget::indicator {
  width: 18px;
  height: 18px;
}

/* ===== Log panel: less "debug", more "secondary" ===== */
QTextEdit[log="true"] {
  background: #0f172a;
  color: #e5e7eb;
  border: 1px solid #1f2937;
  border-radius: 10px;
  padding: 8px;
  font-family: Consolas;
  font-size: 11px;
}
